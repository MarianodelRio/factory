# factory-template: codex/factory.rules@1
# Software Factory: Codex asks the person before approving or rejecting a design (design §4.4).
# Codex loads project rules only when this project's .codex/ layer is trusted.
prefix_rule(
    pattern = ["factory", "design", ["approve", "reject"]],
    decision = "prompt",
    justification = "Approving or rejecting a design needs the person's explicit permission.",
    match = [
        "factory design approve CHG-0001 --message 'apruebo CHG-0001' --json",
        "factory design reject CHG-0001 --reason 'not now' --json",
    ],
    not_match = [
        "factory design show CHG-0001 --json",
        "factory design register --json",
    ],
)
